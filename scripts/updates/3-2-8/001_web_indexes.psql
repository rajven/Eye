-- ============================================================================
-- 001: indexes for the queries of the web interface
-- applies to: PostgreSQL 10+
-- every statement is idempotent (IF NOT EXISTS), the patch can be re-run
-- on a big base consider CREATE INDEX CONCURRENTLY instead (run outside a
-- transaction, one statement at a time), the lists keep answering meanwhile
-- the priority marks: P0 = a sequential scan on every page or on every row
-- of a report, P1 = the log and report pages, P2 = the secondary pages
-- ============================================================================

-- ============================================================================
-- P0. the hot path
-- ============================================================================

-- ResolveIP() reads the ptr cache by ip for every row of every traffic
-- report; the existing (dns, ip) index keeps dns first and can not serve it
CREATE INDEX IF NOT EXISTS idx_dns_cache_ip ON dns_cache(ip);

-- connections had no index at all on postgres (mysql keeps its own set):
-- the connection cell of the ip list and of the user pages reads by auth_id,
-- the port dialogs of the device pages read by port_id, the device pages
-- read by device_id
CREATE INDEX IF NOT EXISTS idx_connections_auth_id ON connections(auth_id);
CREATE INDEX IF NOT EXISTS idx_connections_port_id ON connections(port_id);
CREATE INDEX IF NOT EXISTS idx_connections_device_id ON connections(device_id);

-- the owner of an address: the pages of the user, the counters of the ip
-- list, the api, the batch maps of the list pages
CREATE INDEX IF NOT EXISTS idx_user_auth_user_id ON user_auth(user_id, deleted);

-- the live ip list: the default page reads deleted = 0 ordered by ip_int,
-- the dup checks of the user pages and the api read by ip_int / mac,
-- one partial index serves the ordered scan and the equality lookups alike
CREATE INDEX IF NOT EXISTS idx_user_auth_ip_int_active ON user_auth(ip_int) WHERE deleted = 0;
CREATE INDEX IF NOT EXISTS idx_user_auth_mac_active ON user_auth(mac) WHERE deleted = 0;

-- the archive page of the ip list: the deleted records ordered by ip
CREATE INDEX IF NOT EXISTS idx_user_auth_deleted_ip_int ON user_auth(deleted, ip_int);

-- the hostname of an address: the dup checks of the user pages
CREATE INDEX IF NOT EXISTS idx_user_auth_dns_name ON user_auth(dns_name);

-- the log of the new addresses reads a day window of user_auth
CREATE INDEX IF NOT EXISTS idx_user_auth_ts ON user_auth(ts);

-- the traffic of one user: the day and month reports, the blocked page of
-- the subscriber; the existing (ts, auth_id, router_id) serves the global
-- report, these two serve the per user one
CREATE INDEX IF NOT EXISTS idx_user_stats_auth_ts ON user_stats(auth_id, ts);
CREATE INDEX IF NOT EXISTS idx_user_stats_full_auth_ts ON user_stats_full(auth_id, ts);

-- the aliases of an address: the cell of the ip list, the dup checks of the
-- alias dialog (mysql keeps the auth_id index, postgres did not)
CREATE INDEX IF NOT EXISTS idx_user_auth_alias_auth_id ON user_auth_alias(auth_id);
CREATE INDEX IF NOT EXISTS idx_user_auth_alias_alias ON user_auth_alias(alias);

-- the vendor of a mac: every list page resolves the oui of its rows, the
-- vendor table counts tens of thousands of rows
CREATE INDEX IF NOT EXISTS idx_mac_vendors_oui ON mac_vendors(oui);

-- the bootstrap reads its options by option_id about 25 times a request
CREATE INDEX IF NOT EXISTS idx_config_option_id ON config(option_id);

-- ============================================================================
-- P1. the log and report pages
-- ============================================================================

-- the dhcp log filters by ip / mac inside a day window
CREATE INDEX IF NOT EXISTS idx_dhcp_log_ip_int_ts ON dhcp_log(ip_int, ts);
CREATE INDEX IF NOT EXISTS idx_dhcp_log_mac_ts ON dhcp_log(mac, ts);

-- the netflow report: the default page reads a time window, the ip search
-- reads the flows of one address; the existing indexes keep auth_id first
-- and can not serve these, on the biggest table of the base consider
-- CONCURRENTLY for the build
CREATE INDEX IF NOT EXISTS idx_traffic_detail_ts ON traffic_detail(ts);
CREATE INDEX IF NOT EXISTS idx_traffic_detail_src_ts ON traffic_detail(src_ip, ts);
CREATE INDEX IF NOT EXISTS idx_traffic_detail_dst_ts ON traffic_detail(dst_ip, ts);

-- the wan report reads the history of one interface of one router, the
-- existing (ts, router_id, interface_id) keeps ts first
CREATE INDEX IF NOT EXISTS idx_wan_stats_router_interface_ts ON wan_stats(router_id, interface_id, ts);

-- the remote syslog of postgres had no index at all, the page always reads
-- a time window and often the addresses of one device
CREATE INDEX IF NOT EXISTS idx_remote_syslog_ts ON remote_syslog(ts);
CREATE INDEX IF NOT EXISTS idx_remote_syslog_ip_ts ON remote_syslog(ip, ts);

-- php sessions: the garbage collector deletes by last_accessed on every
-- request (mysql keeps this index, postgres did not)
CREATE INDEX IF NOT EXISTS idx_sessions_last_accessed ON sessions(last_accessed);

-- the locks: the expired variables are read and cleaned by clear_time
CREATE INDEX IF NOT EXISTS idx_variables_clear_time ON variables(clear_time);

-- ============================================================================
-- P2. the secondary pages
-- ============================================================================

-- the ou filter of the lists and the delete protection of the api
CREATE INDEX IF NOT EXISTS idx_user_list_ou_id ON user_list(ou_id);

-- the user select: the dropdown reads the live users ordered by login
CREATE INDEX IF NOT EXISTS idx_user_list_login_active ON user_list(login) WHERE deleted = 0;

-- the devices of a user and the device of an address
CREATE INDEX IF NOT EXISTS idx_devices_user_id ON devices(user_id);
CREATE INDEX IF NOT EXISTS idx_devices_ip_int ON devices(ip_int);

-- the zabbix bindings which the monitoring page counts per device (mysql
-- keeps both indexes, postgres kept only the (macros_list_id, device_id)
-- and (tags_list_id, device_id) unique keys)
CREATE INDEX IF NOT EXISTS idx_zabbix_macros_device ON zabbix_macros(device_id);
CREATE INDEX IF NOT EXISTS idx_zabbix_tags_device ON zabbix_tags(device_id);

-- the settings pages of a device
CREATE INDEX IF NOT EXISTS idx_device_l3_interfaces_device_id ON device_l3_interfaces(device_id);
CREATE INDEX IF NOT EXISTS idx_gateway_subnets_device_id ON gateway_subnets(device_id);
CREATE INDEX IF NOT EXISTS idx_device_filter_instances_device_id ON device_filter_instances(device_id);

-- the rules of a filter group (mysql keeps GroupId)
CREATE INDEX IF NOT EXISTS idx_group_filters_group_id ON group_filters(group_id);

-- the rules of a user (mysql keeps user_id)
CREATE INDEX IF NOT EXISTS idx_auth_rules_user_id ON auth_rules(user_id);

-- the unknown macs of one device on the log page
CREATE INDEX IF NOT EXISTS idx_unknown_mac_device_ts ON unknown_mac(device_id, ts);

-- ============================================================================
-- optional: the substring search of the user list goes through pg_trgm which
-- create_db already enables, the two indexes cost place but give the search
-- an index instead of a scan of the whole user list
-- ============================================================================
-- CREATE INDEX idx_user_list_login_trgm ON user_list USING GIN(login gin_trgm_ops);
-- CREATE INDEX idx_user_list_description_trgm ON user_list USING GIN(description gin_trgm_ops);
