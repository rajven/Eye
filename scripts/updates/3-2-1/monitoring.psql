ALTER TABLE devices RENAME COLUMN nagios TO monitoring;
ALTER TABLE devices RENAME COLUMN nagios_status TO monitoring_status;
ALTER TABLE devices ADD COLUMN monitoring_old SMALLINT NOT NULL DEFAULT 0;
UPDATE devices SET monitoring_old = monitoring;
COMMENT ON COLUMN devices.monitoring IS 'Enable monitoring for this device';
COMMENT ON COLUMN devices.monitoring_old IS 'Previous value of the monitoring field, used to disable the host in the monitoring system';
COMMENT ON COLUMN devices.monitoring_status IS 'Current host state reported by the monitoring system';
ALTER TABLE device_ports RENAME COLUMN nagios TO monitoring;
ALTER TABLE device_ports ADD COLUMN monitoring_old SMALLINT NOT NULL DEFAULT 0;
UPDATE device_ports SET monitoring_old = monitoring;
COMMENT ON COLUMN device_ports.monitoring IS 'Enable monitoring for this port';
COMMENT ON COLUMN device_ports.monitoring_old IS 'Previous value of the monitoring field';
ALTER TABLE user_auth RENAME COLUMN nagios TO monitoring;
ALTER TABLE user_auth RENAME COLUMN nagios_status TO monitoring_status;
ALTER TABLE user_auth ADD COLUMN monitoring_old SMALLINT NOT NULL DEFAULT 0;
UPDATE user_auth SET monitoring_old = monitoring;
COMMENT ON COLUMN user_auth.monitoring IS 'Enable monitoring for this host, the monitoring system is selected in the config options';
COMMENT ON COLUMN user_auth.monitoring_old IS 'Previous value of the monitoring field, used to disable the host in the monitoring system';
COMMENT ON COLUMN user_auth.monitoring_status IS 'Current host state reported by the monitoring system';
ALTER TABLE ou ADD COLUMN zabbix_group_id INTEGER NOT NULL DEFAULT 0;
COMMENT ON COLUMN ou.zabbix_group_id IS 'Zabbix host group id bound to this organizational unit';
